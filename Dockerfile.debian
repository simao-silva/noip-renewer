FROM python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS builder

SHELL ["/bin/bash", "-c"]

# Prevent Python from writing out pyc files
ENV PYTHONDONTWRITEBYTECODE=1

# Keep Python from buffering stdin/stdout
ENV PYTHONUNBUFFERED=1

# Disable any user interaction
ENV DEBIAN_FRONTEND=noninteractive

# Enable custom virtual environment
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# renovate: datasource=pypi depName=pip versioning=pep440
ARG PIP_VERSION="26.3"

# Set the working directory
WORKDIR /app

# Add requirements file
COPY requirements.txt .

# Install requirements
RUN python3 -m venv "${VIRTUAL_ENV}" && \
    pip install --no-cache-dir --upgrade pip=="${PIP_VERSION}" && \
    pip install --no-cache-dir -r requirements.txt && \
    pip uninstall -y pip


FROM python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928 AS geckodriver

SHELL ["/bin/bash", "-c"]

# Disable any user interaction
ENV DEBIAN_FRONTEND=noninteractive

# renovate: datasource=repology depName=debian_13/curl versioning=loose
ARG CURL_VERSION="8.14.1-2+deb13u7"

# renovate: datasource=github-tags depName=mozilla/geckodriver
ARG GECKODRIVER_VERSION="v0.37.1"

# Install required packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl="${CURL_VERSION}" && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*

# Download geckodriver
RUN set -x && \
    ARCH="$(uname -m)" && \
    if [ "$ARCH" = "x86_64" ]; then \
      ARCH="linux64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
      ARCH="linux-aarch64"; \
    fi && \
    curl --proto "=https" -sSL -O "https://github.com/mozilla/geckodriver/releases/download/${GECKODRIVER_VERSION}/geckodriver-${GECKODRIVER_VERSION}-${ARCH}.tar.gz" && \
    tar zxf "geckodriver-${GECKODRIVER_VERSION}-${ARCH}.tar.gz"


FROM python:3.15.2-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

# Disable any user interaction
ENV DEBIAN_FRONTEND=noninteractive

# renovate: datasource=repology depName=debian_13/firefox-esr versioning=loose
ARG FIREFOX_VERSION="153.7.0esr-1~deb13u1"

# renovate: datasource=repology depName=debian_13/zlib versioning=loose
ARG ZLIB_VERSION="1:1.3.dfsg+really1.3.1-1+deb13u1"

# Install required packages and apply fixes for vulnerabilities reported by Trivy
RUN apt-get update && \
    apt-get install -y --no-install-recommends firefox-esr="${FIREFOX_VERSION}" && \
    pip uninstall -y pip && \
    apt-get upgrade -y zlib1g="${ZLIB_VERSION}" && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /tmp/* /var/lib/apt/lists/* /var/cache/apt/archives/* /var/tmp/* /usr/share/doc /usr/share/man

# Enable custom virtual environment
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy dependencies from previous stage
COPY --from=builder $VIRTUAL_ENV $VIRTUAL_ENV

# Copy geckodriver from previous stage
COPY --from=geckodriver --chmod=755 /geckodriver /usr/local/bin/geckodriver

# Set the working directory
WORKDIR /app

# Copy and set the entrypoint bash script
COPY renew.py .
ENTRYPOINT ["python3", "renew.py"]
